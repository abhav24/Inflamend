{
  "expo": {
    "name": "Inflamend",
    "slug": "inflamend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inflamend.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph meals for your food log.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to your food log entries.",
        "NSUserNotificationsUsageDescription": "Used to send medication reminders.",
        "NSHealthShareUsageDescription": "Inflamend reads Health data (like steps and sleep) to personalize your symptom insights.",
        "NSHealthUpdateUsageDescription": "Inflamend may write wellness summaries to Health when you enable sync."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.inflamend.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4A90D9"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "inflamend"
  }
}
